{
  "name": "@voltdev/ui",
  "version": "0.1.0-alpha.1",
  "description": "Components and a stylesheet, built on @voltdev/primitives.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voltdev/core": "workspace:*",
    "@voltdev/primitives": "workspace:*"
  },
  "keywords": [
    "volt",
    "components",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/ui"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "volt": {
    "source": true
  }
}
