{
  "name": "@voltdev/vite-plugin",
  "version": "0.1.0-alpha.1",
  "description": "Compile Volt templates at build time so no compiler ships to the browser.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./ssg": {
      "types": "./dist/ssg.d.ts",
      "import": "./dist/ssg.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voltdev/compiler": "workspace:*",
    "esbuild": "^0.28.2",
    "magic-string": "^0.30.21",
    "sass": "^1.102.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "keywords": [
    "vite-plugin",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
