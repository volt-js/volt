{
  "name": "@voltdev/reactivity",
  "version": "0.1.0-alpha.2",
  "description": "TC39-conformant signals with Volt's effect scheduling and disposal scopes.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./dist/signals.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "signals",
    "reactivity",
    "tc39",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/reactivity"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
