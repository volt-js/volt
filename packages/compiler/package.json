{
  "name": "@voltdev/compiler",
  "version": "0.1.0-alpha.2",
  "description": "Volt template compiler \u2014 parses ':'-prefixed templates and emits fine-grained DOM code.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "compiler",
    "template",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
