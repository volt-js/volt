{
  "name": "@voltdev/query",
  "version": "0.1.0-alpha.1",
  "description": "Volt's shared server-state cache — one entry per key, deduplicated, revalidated.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voltdev/primitives": "workspace:^"
  },
  "peerDependencies": {
    "@voltdev/core": "workspace:^"
  },
  "devDependencies": {
    "@voltdev/core": "workspace:*"
  },
  "keywords": [
    "volt",
    "query",
    "cache",
    "server-state"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/query"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
