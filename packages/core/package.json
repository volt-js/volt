{
  "name": "@voltdev/core",
  "version": "0.1.0-alpha.1",
  "description": "Volt core \u2014 class components, lifecycle, and the fine-grained DOM runtime.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./jit": {
      "types": "./dist/jit.d.ts",
      "import": "./dist/jit.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./dist/signals.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voltdev/reactivity": "workspace:*",
    "@voltdev/compiler": "workspace:*"
  },
  "keywords": [
    "ui",
    "framework",
    "components",
    "volt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volt-js/volt.git",
    "directory": "packages/core"
  },
  "homepage": "https://voltjs.dev",
  "bugs": {
    "url": "https://github.com/volt-js/volt/issues"
  },
  "author": "Hardik Viradiya",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
